# Copie para .env para rodar local (`export $(grep -v '^#' .env | xargs)`
# antes de chamar npm run monitorar). Em produção (GitHub Actions / cron no
# Mac) estas variáveis vêm de secrets/ambiente de verdade — não deste
# arquivo.

# URL base do admin em produção, sem barra no fim.
MONITOR_API_URL=https://maquinacerta.com.br

# Mesmo valor de MONITOR_API_TOKEN no .env do repositório principal
# (comparador-maquininhas), config/services.php -> services.monitor.token.
MONITOR_API_TOKEN=

# Bot criado com @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=
# Chat (pessoal ou de grupo) que recebe os alertas. Descobrir com
# https://api.telegram.org/bot<TOKEN>/getUpdates depois de mandar uma
# mensagem qualquer para o bot.
TELEGRAM_CHAT_ID=

# https://aistudio.google.com/apikey — camada gratuita.
GEMINI_API_KEY=
# Opcional — default em src/config.mjs.
# GEMINI_MODEL=gemini-2.0-flash

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
# Regra 11: datas em dd/mm/aaaa, no fuso de Sao Paulo.
APP_TIMEZONE=America/Sao_Paulo
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Fecha o site publico (503 + noindex) e deixa o /admin de pe — ver
# config/site.php e App\Http\Middleware\SiteEmBreve. NAO e o `artisan down`,
# que derrubaria o painel junto. Ligado em producao desde a etapa 11: o portal
# espera a identidade visual propria e a aprovacao das 964 taxas.
SITE_EM_BREVE=false
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Em producao isto e `sync`, e a escolha tem motivo (etapa 11):
# Filament\Auth\Notifications\ResetPassword implementa ShouldQueue, entao o
# e-mail de redefinicao de senha vai para a fila. Sem um worker rodando ele
# fica parado na tabela `jobs` PARA SEMPRE — sem erro, sem log, e com a tela
# dizendo "Enviamos o link". O app nao despacha job proprio, entao uma fila de
# verdade seria manutencao paga por uma capacidade que ninguem usa.
# Revisitar se a etapa 14 (monitor de mudancas) trouxer trabalho pesado.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em local fica `log`: o unico e-mail que o app envia e a recuperacao de senha
# do painel, e mandar isso para storage/logs em desenvolvimento e o suficiente.
#
# Em producao (Hostinger, etapa 11) e SMTP. A Hostinger exige que o remetente
# seja a propria caixa autenticada, entao MAIL_USERNAME e MAIL_FROM_ADDRESS
# sao o mesmo endereco:
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps          # Laravel 13 usa MAIL_SCHEME, nao MAIL_ENCRYPTION
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_USERNAME=contato@maquinacerta.com.br
#   MAIL_PASSWORD='...'        # aspas simples: a senha pode ter $ e !
#
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Etapa 10 — pendentes da etapa de lançamento (ver CLAUDE.md):
# GA4_MEASUREMENT_ID=G-XXXXXXX
# Etapa 12: mapa de calor e gravacao de sessao, atras do mesmo consentimento.
# CLARITY_PROJECT_ID=xxxxxxxxxx
# LEGAL_RAZAO_SOCIAL=
# LEGAL_CNPJ=
# LEGAL_EMAIL_CONTATO=

# Etapa 13: autentica /api/monitor/* (App\Http\Middleware\AutenticaMonitor).
# O mesmo valor precisa existir como secret MONITOR_API_TOKEN no repositorio
# separado do monitor de mudancas. Gerar com:
# php artisan tinker --execute="echo Str::random(48);"
MONITOR_API_TOKEN=

# Etapa 16 (painel de saude do admin) — os quatro sao opcionais: sem eles, os
# cartoes correspondentes mostram "Sem dado" com o motivo, nunca um numero
# inventado (ver CLAUDE.md, "Painel de saude do administrador").
#
# Caminho absoluto do log que scripts/backup-comparador.sh escreve NO
# SERVIDOR (nao e caminho de codigo, e da conta) — em producao:
# /home/u835756808/backups/comparador/backup.log
# BACKUP_LOG_PATH=

# Host cujo certificado TLS o cartao de operacao confere. Cai para o host de
# APP_URL quando vazio — so preencha se o dominio do certificado for
# diferente.
# SAUDE_DOMINIO_SSL=

# Token da GraphQL Analytics API da Cloudflare (Zone Analytics Read) e o
# Zone ID da zona maquinacerta.com.br. A etapa 12 deixou DNS/SSL/regras
# prontos, mas nao gerou o token — fica para quando houver trafego real.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
